# Starter runs without these values. Copy to .env.local when implementing integrations.
# Public configuration only; never put service-role or signing keys in NEXT_PUBLIC_*.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values; leave unconfigured until the corresponding feature is implemented.
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# AI_MODEL=
# ZEROX_API_KEY=
# SEPOLIA_RPC_URL=
