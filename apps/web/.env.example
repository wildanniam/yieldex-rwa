# Copy to .env.local; ignored. Never expose server values using NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3000
DATABASE_URL=
# Hosted only: official PEM CA, preserves TLS certificate verification.
DATABASE_SSL_CA=
MARKETPLACE_RPC_URL=
DEPLOYMENT_MANIFEST=
# Vercel can supply the validated public manifest as JSON instead of a local file.
DEPLOYMENT_MANIFEST_JSON=
CURSOR_SECRET=
ZEROX_API_KEY=
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
OPENAI_API_KEY=
AI_MODEL=
# Enable only behind an edge which OVERWRITES x-real-ip; otherwise use process budget.
TRUST_PROXY_IP_HEADER=0
